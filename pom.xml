<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.apex</groupId>
    <artifactId>apex-financial-engine</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <modules>
        <module>apex-domain</module>
        <module>apex-application</module>
        <module>apex-infrastructure</module>
        <module>apex-bootstrap</module>
        <module>apex-sdk-api</module>
        <module>apex-sdk-messaging</module>
        <module>apex-sdk-spring-boot</module>
        <module>apex-sdk-webmvc</module>
        <module>apex-sdk-grpc</module>
        <module>apex-sdk-grpc-server</module>
        <module>apex-sdk-grpc-client</module>
        <module>apex-order-contracts</module>
        <module>apex-sdk-discovery</module>
        <module>apex-sdk-discovery-eureka</module>
        <module>apex-sdk-discovery-kubernetes</module>
        <module>apex-sdk-discovery-grpc</module>
        <module>apex-sdk-observability</module>
        <module>apex-sdk-operations</module>
        <module>apex-operations-console</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <apex.sdk.version>${project.version}</apex.sdk.version>
        <apex.spring-boot.version>4.1.1</apex.spring-boot.version>
        <apex.spring-cloud.version>2025.1.3</apex.spring-cloud.version>
    </properties>

    <!-- Reuse this existing parent/importable POM; capability artifacts remain opt-in. -->
    <dependencyManagement><dependencies>
        <dependency><groupId>org.springframework.cloud</groupId><artifactId>spring-cloud-dependencies</artifactId><version>${apex.spring-cloud.version}</version><type>pom</type><scope>import</scope></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-api</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-spring-boot</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-webmvc</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-messaging</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-grpc</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-grpc-client</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-grpc-server</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-discovery</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-discovery-eureka</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-discovery-kubernetes</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-discovery-grpc</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-observability</artifactId><version>${apex.sdk.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-operations</artifactId><version>${apex.sdk.version}</version></dependency>
    </dependencies></dependencyManagement>


</project>
