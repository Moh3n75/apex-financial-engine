{
  "openapi": "3.1.0",
  "info": {
    "title": "APEX OPS-03C opt-in loopback search",
    "version": "1",
    "description": "Only implemented search routes. Existing fixed-ID snapshot v1 routes remain separate and unchanged. No production or complete-history claim."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9190"
    }
  ],
  "paths": {
    "/ops/v1/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "Bounded current OUTBOX_EVENT metadata; partial, not history",
        "description": "Explicit configured deployment service-account grant. UTC Z timestamps, at most one hour and last hour only. Limit bounds candidates before time/state filtering; empty items may have nextCursor. Restart from first page to reconcile late commits. Requests require an independent owner client-scoped grant. No public ingress or M36 authorization.",
        "parameters": [
          {
            "name": "environment",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "owner",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 40,
              "default": "ANY"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16,
              "default": 16
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current source sample or explicit missing/stale/degraded result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "400": {
            "description": "Invalid bounds, cursor, duplicate or unsupported parameter"
          },
          "403": {
            "description": "Environment/owner/kind/scope not configured"
          },
          "405": {
            "description": "Mutation denied"
          }
        }
      }
    },
