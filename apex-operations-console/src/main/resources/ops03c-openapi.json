  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "maxLength": 40
          },
          "sourceAssignedAt": {
            "type": "string",
            "format": "date-time"
          },
          "evidenceKey": {
            "type": "string"
          },
          "evidenceClass": {
            "const": "OWNER_COMMITTED_ROW"
          },
          "certainty": {
            "enum": [
              "VERIFIED_WITHIN_SCOPE",
              "UNKNOWN"
            ]
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "environment": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "nextCursor": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "fromInclusive": {
            "type": "string",
            "format": "date-time"
          },
          "toExclusive": {
            "type": "string",
            "format": "date-time"
          },
          "scanStartedAt": {
            "type": "string",
            "format": "date-time"
          },
          "scanCompletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "schemaVersion": {
            "const": 1
          },
          "epoch": {
            "type": "string",
            "format": "uuid"
          },
          "maxAgeMillis": {
            "const": 10000
          },
          "candidatesExamined": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "coverage": {
            "type": "array",
            "items": {
              "enum": [
                "PARTIAL_CURRENT_STATE",
                "RETENTION_UNQUALIFIED",
                "RECONCILE_FROM_START",
                "CANDIDATE_PAGE_LIMIT",
                "WALK_LIMIT",
                "CLOCK_UNCERTAIN"
              ]
            }
          },
          "items": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          }
        }
      },
      "View": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "freshness": {
            "enum": [
              "FRESH",
              "STALE",
              "MISSING",
              "UNKNOWN",
              "CLOCK_UNCERTAIN"
            ]
          },
          "availability": {
            "enum": [
              "AVAILABLE",
              "SHED",
              "BACKOFF",
              "SOURCE_UNAVAILABLE",
              "PERMISSION_GAP"
            ]
          },
          "coverage": {
            "type": "string"
          },
          "page": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Page"
              },
              {
                "type": "null"
              }
            ]
          },
          "brokerAck": {
            "const": "UNKNOWN_NO_VERIFIED_RECEIPT"
          },
          "quarantine": {
            "const": "UNKNOWN_NOT_INSPECTED"
          },
          "uncertainty": {
            "enum": ["UNKNOWN", "PARTIAL_NO_OWNER_REVISION", "CONFLICTING"]
          },
          "priorConflicts": {
            "type": "array",
            "maxItems": 2,
            "description": "Bounded prior observations for this exact authorized query, not authoritative history",
            "items": {"$ref": "#/components/schemas/Page"}
          }
        }
      }
    }
  }
}
