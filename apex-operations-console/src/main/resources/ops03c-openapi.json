    "/ops/v1/search/sources": {
      "get": {
        "operationId": "searchSources",
        "responses": {
          "200": {
            "description": "Configured grants, never proof of live membership",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "properties": {
                      "environment": {
                        "type": "string"
                      },
                      "owner": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ops/v1/search/openapi": {
      "get": {
        "operationId": "searchOpenApi",
        "responses": {
          "200": {
            "description": "This implemented search-only OpenAPI document"
          }
        }
      }
    }
