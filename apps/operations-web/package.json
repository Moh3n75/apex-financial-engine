{
  "name": "operations-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fixture": "playwright test -c playwright.config.ts",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:e2e:m36a-unauth": "playwright test -c playwright.m36a.config.ts",
    "test:e2e:m36a-live": "playwright test -c playwright.m36a-live.config.ts",
    "test:e2e:m36b-live": "playwright test -c playwright.m36b.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:fixture-e2e": "pnpm verify && pnpm test:e2e:fixture"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "5.10.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "openid-client": "5.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "6.3.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.9"
}
