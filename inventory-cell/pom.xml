<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.apex</groupId>
    <artifactId>inventory-cell</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <description>M26.4 independent Inventory scaffold using the existing APEX Starters.</description>
    <properties>
        <java.version>21</java.version>
        <apex.platform.version>1.0-SNAPSHOT</apex.platform.version>
    </properties>
    <dependencies>
        <dependency><groupId>com.apex</groupId><artifactId>apex-starter-grpc-server</artifactId><version>${apex.platform.version}</version></dependency>
        <dependency><groupId>com.apex</groupId><artifactId>apex-order-contracts</artifactId><version>${apex.platform.version}</version></dependency>
        <dependency>
            <groupId>com.apex</groupId>
            <artifactId>apex-starter-webmvc</artifactId>
            <version>${apex.platform.version}</version>
        </dependency>
        <dependency>
            <groupId>com.apex</groupId>
            <artifactId>apex-starter-cell-messaging</artifactId>
            <version>${apex.platform.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>inventory-cell</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>saga-packaged-e2e</id>
                        <phase>integration-test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes><include>**/OrderInventorySagaIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <reportsDirectory>${project.build.directory}/saga-e2e-reports</reportsDirectory>
                            <systemPropertyVariables>
                                <saga.repositoryRoot>${project.basedir}/..</saga.repositoryRoot>
                                <saga.inventoryJar>${project.build.directory}/inventory-cell.jar</saga.inventoryJar>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>m30</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- Explicit tool invocation only: this nested clean build must
                         finish before the Cell artifact-receipt workflow. -->
                    <execution><id>financial-isolated-build</id><phase>none</phase><goals><goal>test</goal></goals>
                        <configuration>
                            <includes><include>**/FinancialBuildIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <reportsDirectory>${project.build.directory}/financial-build-reports</reportsDirectory>
                            <systemPropertyVariables><saga.repositoryRoot>${project.basedir}/..</saga.repositoryRoot></systemPropertyVariables>
                        </configuration>
                    </execution>
                    <execution><id>saga-performance</id><phase>integration-test</phase><goals><goal>test</goal></goals>
                        <configuration>
                            <includes><include>**/SagaPerformanceIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <reportsDirectory>${project.build.directory}/performance-reports</reportsDirectory>
                            <systemPropertyVariables>
                                <saga.repositoryRoot>${project.basedir}/..</saga.repositoryRoot>
                                <saga.inventoryJar>${project.build.directory}/inventory-cell.jar</saga.inventoryJar>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>operational-recovery</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>operational-recovery-packaged</id>
                                <phase>integration-test</phase>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <includes><include>**/OperationalRecoverySagaIT.java</include></includes>
                                    <failIfNoTests>true</failIfNoTests>
                                    <reportsDirectory>${project.build.directory}/operational-recovery-reports</reportsDirectory>
                                    <systemPropertyVariables>
                                        <saga.repositoryRoot>${project.basedir}/..</saga.repositoryRoot>
                                        <saga.inventoryJar>${project.build.directory}/inventory-cell.jar</saga.inventoryJar>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>three-cell</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <executions><execution><id>three-cell-packaged</id><phase>integration-test</phase><goals><goal>test</goal></goals>
                    <configuration>
                        <includes><include>**/ThreeCellSagaIT.java</include></includes>
                        <reportsDirectory>${project.build.directory}/three-cell-reports</reportsDirectory>
                        <systemPropertyVariables>
                            <saga.repositoryRoot>${project.basedir}/..</saga.repositoryRoot>
                            <saga.inventoryJar>${project.build.directory}/inventory-cell.jar</saga.inventoryJar>
                        </systemPropertyVariables>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
<profile><id>discovery-eureka</id><dependencyManagement><dependencies><dependency><groupId>org.springframework.cloud</groupId><artifactId>spring-cloud-dependencies</artifactId><version>2025.1.3</version><type>pom</type><scope>import</scope></dependency></dependencies></dependencyManagement><dependencies><dependency><groupId>com.apex</groupId><artifactId>apex-discovery-eureka</artifactId><version>1.0-SNAPSHOT</version></dependency></dependencies></profile>
<profile><id>discovery-kubernetes</id><dependencyManagement><dependencies><dependency><groupId>org.springframework.cloud</groupId><artifactId>spring-cloud-dependencies</artifactId><version>2025.1.3</version><type>pom</type><scope>import</scope></dependency></dependencies></dependencyManagement><dependencies><dependency><groupId>com.apex</groupId><artifactId>apex-discovery-kubernetes</artifactId><version>1.0-SNAPSHOT</version></dependency></dependencies></profile>
</profiles>
</project>
