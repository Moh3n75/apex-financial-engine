<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>example.external</groupId>
    <artifactId>sdk-consumer</artifactId>
    <version>0.0.1-EXTERNAL</version>
    <properties><java.version>21</java.version><apex.sdk.version>1.0-SNAPSHOT</apex.sdk.version><external.test.source>src/test/java</external.test.source></properties>
    <dependencyManagement><dependencies><dependency>
        <groupId>com.apex</groupId><artifactId>apex-financial-engine</artifactId><version>${apex.sdk.version}</version><type>pom</type><scope>import</scope>
    </dependency></dependencies></dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>com.apex</groupId>
            <artifactId>apex-sdk-spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile><id>messaging</id>
            <dependencies>
                <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-messaging</artifactId></dependency>
                <dependency><groupId>io.zonky.test</groupId><artifactId>embedded-postgres</artifactId><version>2.1.0</version><scope>test</scope></dependency>
                <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId><scope>test</scope></dependency>
                <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId><scope>test</scope></dependency>
                <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka-test</artifactId><scope>test</scope></dependency>
            </dependencies>
            <properties><external.test.source>src/messaging-test/java</external.test.source></properties>
        </profile>
        <profile><id>discovery-kubernetes</id>
            <dependencies><dependency><groupId>com.apex</groupId><artifactId>apex-sdk-discovery-kubernetes</artifactId></dependency></dependencies>
            <properties><external.test.source>src/discovery-test/java</external.test.source></properties>
        </profile>
        <profile><id>discovery-eureka</id>
            <dependencies><dependency><groupId>com.apex</groupId><artifactId>apex-sdk-discovery-eureka</artifactId></dependency></dependencies>
            <properties><external.test.source>src/discovery-test/java</external.test.source></properties>
        </profile>
        <profile>
            <id>rpc-client</id>
            <dependencies><dependency><groupId>com.apex</groupId><artifactId>apex-sdk-grpc-client</artifactId></dependency></dependencies>
            <properties><external.test.source>src/isolation-test/java</external.test.source></properties>
        </profile>
        <profile>
            <id>rpc-server</id>
            <dependencies><dependency><groupId>com.apex</groupId><artifactId>apex-sdk-grpc-server</artifactId></dependency></dependencies>
            <properties><external.test.source>src/isolation-test/java</external.test.source></properties>
        </profile>
        <profile>
            <id>operations</id>
            <dependencies><dependency><groupId>com.apex</groupId><artifactId>apex-sdk-operations</artifactId></dependency></dependencies>
            <properties><external.test.source>src/isolation-test/java</external.test.source></properties>
        </profile>
        <profile>
            <id>observability</id>
            <dependencies><dependency><groupId>com.apex</groupId><artifactId>apex-sdk-observability</artifactId></dependency></dependencies>
            <properties><external.test.source>src/observability-test/java</external.test.source></properties>
        </profile>
        <profile>
            <id>capabilities</id>

            <dependencies>
                <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-operations</artifactId></dependency>
                <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-messaging</artifactId></dependency>
                <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-grpc-client</artifactId></dependency>
                <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-grpc-server</artifactId></dependency>
                <dependency><groupId>com.apex</groupId><artifactId>apex-sdk-discovery-eureka</artifactId></dependency>
                <dependency><groupId>io.zonky.test</groupId><artifactId>embedded-postgres</artifactId><version>2.1.0</version><scope>test</scope></dependency>
                <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId><scope>test</scope></dependency>
                <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId><scope>test</scope></dependency>
                <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka-test</artifactId><scope>test</scope></dependency>
            </dependencies>
            <properties><external.test.source>src/capability-test/java</external.test.source></properties>
        </profile>
        <profile>
            <id>http</id>
            <dependencies>
                <dependency>
                    <groupId>com.apex</groupId>
                    <artifactId>apex-sdk-webmvc</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
    <build>
        <testSourceDirectory>${external.test.source}</testSourceDirectory>
        <finalName>sdk-consumer</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
