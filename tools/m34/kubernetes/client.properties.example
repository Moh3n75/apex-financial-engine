spring.profiles.active=kubernetes
apex.discovery.provider=kubernetes
spring.cloud.kubernetes.client.master-url=https://kubernetes.default.svc
spring.cloud.kubernetes.client.namespace=apex-m34
apex.discovery.kubernetes.ca-file=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
apex.discovery.kubernetes.token-file=/var/run/secrets/kubernetes.io/serviceaccount/token
apex.discovery.refresh-interval=1s
apex.discovery.max-stale-ms=15000
apex.discovery.targets.order-cell.authority=order-cell.apex-m34.svc.cluster.local
apex.discovery.grpc.enabled=true
apex.grpc.client.enabled=true
apex.grpc.cell-id=operator-client
apex.grpc.destinations.order-cell.channel=order
spring.grpc.client.channel.order.target=dns:///order-cell.apex-m34.svc.cluster.local:443
spring.grpc.client.channel.order.ssl.enabled=true
spring.grpc.client.channel.order.ssl.bundle=client
spring.ssl.bundle.pem.client.keystore.certificate=file:/etc/apex-tls/tls.crt
spring.ssl.bundle.pem.client.keystore.private-key=file:/etc/apex-tls/tls.key
spring.ssl.bundle.pem.client.truststore.certificate=file:/etc/apex-tls/ca.crt
