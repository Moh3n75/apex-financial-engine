spring.profiles.active=kubernetes
apex.gateway.mode=loopback-development
server.address=127.0.0.1
server.port=8080
apex.discovery.provider=kubernetes
spring.cloud.kubernetes.client.master-url=https://kubernetes.default.svc
spring.cloud.kubernetes.client.namespace=apex-m34
apex.discovery.kubernetes.ca-file=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
apex.discovery.kubernetes.token-file=/var/run/secrets/kubernetes.io/serviceaccount/token
apex.discovery.refresh-interval=1s
apex.discovery.max-stale-ms=15000
apex.discovery.targets.order-cell.authority=order-cell.apex-m34.svc.cluster.local
